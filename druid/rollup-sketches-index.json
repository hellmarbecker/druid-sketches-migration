{
  "type": "index_parallel",
  "spec": {
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "local",
        "baseDir": "/Users/hellmarbecker/apache-druid-37.0.0/quickstart/tutorial",
        "filter": "wikiticker-2015-09-12-sampled.json.gz"
      },
      "inputFormat": { "type": "json" }
    },
    "tuningConfig": {
      "type": "index_parallel",
      "partitionsSpec": { "type": "dynamic" },
      "maxRowsInMemory": 25000
    },
    "dataSchema": {
      "dataSource": "wikipedia_rollup_sketches",
      "timestampSpec": { "column": "time", "format": "iso" },
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "DAY",
        "queryGranularity": "HOUR",
        "rollup": true,
        "intervals": ["2015-09-12/2015-09-13"]
      },
      "dimensionsSpec": {
        "dimensions": ["channel", "countryName", "isRobot"]
      },
      "metricsSpec": [
        { "type": "count", "name": "count" },
        { "type": "longSum", "name": "sum_added", "fieldName": "added" },

        {
          "comment": "Druid defaults: lgK=12, HLL_4. Dense form has a 4-bit register array + exceptions table.",
          "type": "HLLSketchBuild",
          "name": "users_hll_k12_hll4",
          "fieldName": "user",
          "lgK": 12,
          "tgtHllType": "HLL_4"
        },
        {
          "comment": "Deliberately non-default so the spike proves it reads lgK/tgtType per column rather than assuming.",
          "type": "HLLSketchBuild",
          "name": "pages_hll_k14_hll8",
          "fieldName": "page",
          "lgK": 14,
          "tgtHllType": "HLL_8"
        },

        {
          "type": "thetaSketch",
          "name": "users_theta_16384",
          "fieldName": "user",
          "size": 16384
        },
        {
          "comment": "Two quantiles families over the SAME field, so they can be compared against each other and against the raw distribution. Classic quantiles at non-default k=256.",
          "type": "quantilesDoublesSketch",
          "name": "added_quantiles_k256",
          "fieldName": "added",
          "k": 256
        },
        {
          "comment": "KLL over the same field at its default k=200 -- a different family with a different binary format.",
          "type": "KllDoublesSketch",
          "name": "added_kll_k200",
          "fieldName": "added",
          "k": 200
        },

        {
          "type": "thetaSketch",
          "name": "pages_theta_4096",
          "fieldName": "page",
          "size": 4096
        }
      ]
    }
  }
}
