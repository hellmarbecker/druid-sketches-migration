# Template for .env (which is gitignored). Copy to .env and fill in local paths.

# Apache Druid installation directory (source system).
DRUID_HOME=/path/to/apache-druid-37.0.0

# Druid query endpoint (router).
DRUID_ROUTER_URL=http://localhost:8888

# ClickHouse target.
CLICKHOUSE_BINARY=/path/to/clickhouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
