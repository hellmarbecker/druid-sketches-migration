<?xml version="1.0"?>
<!-- Minimal single-node ClickHouse config for the migration fixture.
     Data lives outside the repo, under $HOME/.local/share/clickhouse-druid-migration. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>

    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <listen_host>127.0.0.1</listen_host>

    <path>/Users/hellmarbecker/.local/share/clickhouse-druid-migration/</path>
    <tmp_path>/Users/hellmarbecker/.local/share/clickhouse-druid-migration/tmp/</tmp_path>
    <user_files_path>/Users/hellmarbecker/.local/share/clickhouse-druid-migration/user_files/</user_files_path>

    <mark_cache_size>268435456</mark_cache_size>
    <default_profile>default</default_profile>
    <default_database>default</default_database>

    <!-- Executable UDF that unions carried DataSketches HLL blobs at query time.
         ClickHouse has no user-defined *aggregate* functions, so the pattern is
         groupArray() -> scalar UDF. See clickhouse/hll_merge_udf.py. -->
    <user_scripts_path>/Users/hellmarbecker/druid-sketches-migration/clickhouse/</user_scripts_path>
    <user_defined_executable_functions_config>/Users/hellmarbecker/druid-sketches-migration/clickhouse/*_function.xml</user_defined_executable_functions_config>

    <users>
        <default>
            <password></password>
            <networks><ip>127.0.0.1</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>
    <profiles>
        <default/>
    </profiles>
    <quotas>
        <default/>
    </quotas>
</clickhouse>
