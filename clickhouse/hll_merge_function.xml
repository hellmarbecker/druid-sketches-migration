<functions>
    <!-- execute_direct=0 runs the command through a shell, so the venv interpreter can be
         named explicitly instead of relying on a shebang plus the executable bit. -->
    <function>
        <type>executable</type>
        <name>hllMergeEstimate</name>
        <return_type>Float64</return_type>
        <argument>
            <type>String</type>
            <name>sketches_csv</name>
        </argument>
        <format>TabSeparated</format>
        <execute_direct>0</execute_direct>
        <command>/Users/hellmarbecker/druid-sketches-migration/.venv/bin/python /Users/hellmarbecker/druid-sketches-migration/clickhouse/hll_merge_udf.py</command>
        <max_command_execution_time>60</max_command_execution_time>
        <command_read_timeout>60000</command_read_timeout>
        <command_write_timeout>60000</command_write_timeout>
    </function>
</functions>
